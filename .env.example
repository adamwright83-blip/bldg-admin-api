# PostHog project token (starts with phc_). Same project for browser and server.
# Do not put a personal API key (phx_) or a secret key (phs_) here.
# Leave unset to disable telemetry. The app must keep running without these.

# Vercel frontend build (admin.bldg.chat and any other Vite surface of this app)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Railway API service (bldg-admin-api) and the Railway procurement worker
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Optional. Default is privacy mode: model, tokens, latency, and trace ids are sent;
# prompt and response text are not. Set to 1 only if that text should be stored in PostHog.
# POSTHOG_AI_CAPTURE_CONTENT=1

# Optional service name on server logs. Defaults to the Railway service name, then bldg-admin-api.
# POSTHOG_SERVICE_NAME=

# Optional. Not required for browser feature flags or remote server evaluation.
# A personal API key (phx_) or project secret (phs_) enables local flag evaluation on the server.
# POSTHOG_SECRET_KEY=

# PostHog project token (starts with phc_). Same project for browser and server.
# Do not put a personal API key (phx_) or a secret key (phs_) here.
# Leave unset to disable telemetry. The app must keep running without these.

# Vercel frontend build (admin.bldg.chat and any other Vite surface of this app)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Railway API service (bldg-admin-api) and the Railway procurement worker
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Optional. Default is privacy mode: model, tokens, latency, and trace ids are sent;
# prompt and response text are not. Set to 1 only if that text should be stored in PostHog.
# POSTHOG_AI_CAPTURE_CONTENT=1

# Optional service name on server logs. Defaults to the Railway service name, then bldg-admin-api.
# POSTHOG_SERVICE_NAME=

# Optional. Not required for browser feature flags or remote server evaluation.
# A personal API key (phx_) or project secret (phs_) enables local flag evaluation on the server.
# POSTHOG_SECRET_KEY=

# JOYSTICK domain front doors. Exact browser origins are in code.
# Do not set these on production from the domain pull request.
# ADMIN_BASE_URL stays https://admin.bldg.chat. Claire and Connect callbacks use it.
# ADMIN_BASE_URL=https://admin.bldg.chat
# Leave VITE_API_URL unset. Front doors call same-origin /api, which rewrites to the main API.
# Do not point it at the resident service.
# VITE_API_URL=
# Resident web and resident API stay on their current hosts.
# VITE_RESIDENT_WEB_ORIGIN=https://laundrybutler.bldg.chat
# RESIDENT_API_URL=https://api.bldg.chat
# Leave JOYSTICK_ALLOWED_ORIGINS unset. Do not add a wildcard gojoystick origin.
# JOYSTICK_ALLOWED_ORIGINS=
# Leave JOYSTICK_DRIVER_PUBLIC_ACCESS unset. Do not enable it for driver.gojoystick.com.
# JOYSTICK_DRIVER_PUBLIC_ACCESS=
# Leave the relay public base unset so the WebSocket stays on ADMIN_BASE_URL.
# CLAIRE_TWILIO_RELAY_PUBLIC_BASE_URL=
# Billing return URL stays https://admin.bldg.chat. The legacy billing app variable is unchanged.

{
  "manifest_version": 3,
  "name": "Gumballpals",
  "version": "0.1.6",
  "description": "Bring your authorized gumball order exports into Goldline using your signed-in browser.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "downloads", "alarms"],
  "optional_host_permissions": [
    "https://cleancloudapp.com/*",
    "https://admin.bldg.chat/*"
  ],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "Open Gumballpals" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}

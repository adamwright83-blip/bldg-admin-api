# Template for the local Cloud Agent development environment.
# `.cursor/install.sh` copies this to ./.env on first setup (./.env is gitignored).
# These are NON-SECRET local development placeholders only. Do not use in production.
NODE_ENV=development
PORT=3000

# Local MySQL 8 provisioned by .cursor/install.sh
DATABASE_URL=mysql://butler:butler@127.0.0.1:3306/laundry_butler

# Session / auth secrets (development placeholders only)
JWT_SECRET=dev-jwt-secret-000000000000000000000000
APP_SHARED_API_SECRET=dev-shared-api-secret-0000000000000000
ADMIN_PASSWORD=dev-admin-password-0000000000000000
OWNER_OPEN_ID=admin-owner
DRIVER_PASSWORD=dev-driver-password-0000000000000000
DRIVER_OPEN_ID=driver-primary

# Stripe is not exercised locally; placeholder only satisfies startup validation.
STRIPE_SECRET_KEY=sk_test_dev_placeholder_0000000000000000

# Guard required by the release-migration runner (pnpm db:dayforge:release).
DAYFORGE_RELEASE_DB=1

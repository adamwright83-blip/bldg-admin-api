{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals", "@playwright/test"]
  },
  "include": [
    "server/legacyDayforgeRelease/**/*.ts",
    "server/territory/testSupport/**/*.ts",
    "playwright.legacy-dayforge.config.ts",
    "e2e/legacy-dayforge/**/*.ts"
  ]
}
